# MapperLab environment variables — copy to .env and fill in values
# Never commit .env to git

# Claude Haiku (for AI event analysis)
ANTHROPIC_API_KEY=sk-ant-...

# FRED API (for macro indicators: VIX, HY OAS, ISM PMI, etc.)
FRED_API_KEY=...

# EIA API (energy data)
EIA_API_KEY=...

# Server port
PORT=3001
