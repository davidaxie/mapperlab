{
  "_meta": {
    "version": "2026-04-15",
    "description": "Comprehensive data source registry for MapperLab.co macro heatmap. Aggregated from central banks, fiscal/regulatory agencies, economic data APIs, trade policy, and geopolitical sources.",
    "notes": "OFAC RSS retired Jan 31 2025 — use XML downloads. PBoC has no RSS — use HTML polling. BIS CBPOL API covers 40+ central banks in one dataset."
  },

  "central_banks": {
    "fed": {
      "name": "Federal Reserve (FOMC)",
      "region": "US",
      "type": "primary",
      "policy_rate_series": "DFF",
      "decision_frequency": "8x/year",
      "feeds": [
        "https://www.federalreserve.gov/feeds/press_monetary.xml",
        "https://www.federalreserve.gov/feeds/press_all.xml",
        "https://www.federalreserve.gov/feeds/speeches.xml",
        "https://www.federalreserve.gov/feeds/press_bcreg.xml",
        "https://www.federalreserve.gov/feeds/press_enforcement.xml",
        "https://www.federalreserve.gov/feeds/h15.xml",
        "https://www.federalreserve.gov/feeds/h8.xml"
      ],
      "apis": {
        "fred_funds_rate": "https://api.stlouisfed.org/fred/series/observations?series_id=DFF&file_type=json&limit=1&sort_order=desc&api_key={FRED_API_KEY}",
        "fred_balance_sheet": "https://api.stlouisfed.org/fred/series/observations?series_id=WALCL&file_type=json&limit=1&sort_order=desc&api_key={FRED_API_KEY}"
      },
      "signals": ["rate_decision", "fomc_statement", "dot_plot", "balance_sheet_qe_qt", "beige_book", "speeches"],
      "sectors_impacted": ["ALL"]
    },

